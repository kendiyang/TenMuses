# Example env vars for local integration runs
# Copy to .env.integration and edit as needed, then run:
#   ./scripts/run-integration.sh

# Containers and images
POSTGRES_CONTAINER=tenmuses-integration-db
POSTGRES_IMAGE=postgres:15
REDIS_CONTAINER=tenmuses-integration-redis
REDIS_IMAGE=redis:7
MINIO_CONTAINER=tenmuses-integration-minio
MINIO_IMAGE=minio/minio:latest

# MinIO credentials (override defaults)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Optional: set database url if not using docker defaults
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/tenmuses

# Optional: set LLM keys for integration tests
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
